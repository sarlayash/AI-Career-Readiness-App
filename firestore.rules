rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all (Pillar 1)
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return (isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email.lower() == "kapilnarula27july@gmail.com")
      ));
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection (Every learner & user across all devices and browsers)
    match /users/{userId} {
      allow get, list: if true;
      allow create: if request.resource.data.keys().hasAll(['uid', 'email', 'role']) &&
        request.resource.data.uid is string &&
        request.resource.data.email is string &&
        request.resource.data.role in ['participant', 'admin'];
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Admin Allowlist Collection
    match /admins/{adminUid} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Assessment Submissions Collection
    match /assessmentSubmissions/{submissionId} {
      allow get, list: if true;
      allow create: if isValidId(submissionId) &&
        request.resource.data.keys().hasAll(['submissionId', 'uid', 'assessmentVersion', 'overallScore', 'readinessBand', 'status']) &&
        request.resource.data.overallScore is number &&
        request.resource.data.overallScore >= 0 &&
        request.resource.data.overallScore <= 100;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Level 2 Applied AI Submissions Collection
    match /level2Submissions/{submissionId} {
      allow get, list: if true;
      allow create: if isValidId(submissionId) &&
        request.resource.data.keys().hasAll(['submissionId', 'uid', 'overallScore', 'tierLabel', 'status']) &&
        request.resource.data.overallScore is number &&
        request.resource.data.overallScore >= 0 &&
        request.resource.data.overallScore <= 100;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Assessment Questions Bank (Public read, Admin write)
    match /assessmentQuestions/{questionId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // Assessment Configs
    match /assessmentConfigs/{configId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // Webinar Configuration
    match /webinarConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // Learning Configuration
    match /learningConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // Admin Audit Logs
    match /adminAuditLogs/{logId} {
      allow read, create: if true;
      allow update, delete: if false; // Audit logs are append-only
    }

    // Webinar Registrations Collection
    match /webinarRegistrations/{registrationId} {
      allow get, list: if true;
      allow create: if request.resource.data.keys().hasAll(['registrationId', 'email', 'webinarTitle', 'registeredAt', 'status']) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 3;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Portal Notifications Collection (Admin & Learner alerts)
    match /portalNotifications/{notificationId} {
      allow get, list: if true; // Filtered on client by recipientUid or recipientType
      allow create: if true; // System / applet generated notification events
      allow update: if true; // Mark as read or cleared
      allow delete: if true;
    }
  }
}
